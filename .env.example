# Скопируйте этот файл в .env и вставьте свои значения.
# .env НЕ коммитится в git (см. .gitignore).

# Токен Telegram-бота (из @BotFather)
TELEGRAM_TOKEN=

# Ключ Anthropic API
ANTHROPIC_API_KEY=

# (необязательно) Разрешённые Telegram-ID через запятую, напр. 123456789,987654321
# Если пусто — бот отвечает всем.
ALLOWED_USER_IDS=
